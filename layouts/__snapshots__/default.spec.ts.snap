              <li class=""><a exactactiveclass="sidebarCurrentLink" class="centerItems buttonLink sidebarLink sidebarLink" draggable="false" title="Playlists">
                  <phplaylist aria-hidden="true" class="icon" size="24" weight="regular"></phplaylist><span class="clamp text">Playlists</span>
                </a></li>
              <li class=""><a exactactiveclass="sidebarCurrentLink" class="centerItems buttonLink sidebarLink sidebarLink" draggable="false" title="Favourites">
                  <phheart aria-hidden="true" class="icon" size="24" weight="regular"></phheart><span class="clamp text">Favourites</span>
                </a></li>
              <li class=""><a exactactiveclass="sidebarCurrentLink" class="centerItems buttonLink sidebarLink sidebarLink" draggable="false" title="Genres">
                  <phwaveform aria-hidden="true" class="icon" size="24" weight="regular"></phwaveform><span class="clamp text">Genres</span>
                </a></li>
            </ul>
          </li>
        </ul>
        <ul class="mBM">
          <li>
            <h4 class="strong mBM sectionHeading"><button aria-expanded="true" class="centerItems spaceBetween sectionToggle" type="button"><span>Playlist</span>
                <phcaretdown aria-hidden="true" class="chevron" size="18" style="transform: rotate(0deg);"></phcaretdown>
              </button></h4>
            <ul>
              <!--v-if-->
              <li><button class="centerItems buttonLink centerAll fullWidth sidebarLink sidebarLink" draggable="false" type="button" title="Add playlist">
                  <phlistplus aria-hidden="true" class="icon" size="24" weight="regular"></phlistplus><span class="clamp text"> Add playlist </span>
                </button></li>
            </ul>
          </li>
        </ul>
      </nav>
    </div>
    <nav class="mobileOnly">
      <ul class="inner centerAll spaceBetween mobileNavigation">
        <li class="item"><a class="centerItems buttonLink link smallFont column centerAll link smallFont column centerAll" draggable="false" title="Browse">
            <phcompass aria-hidden="true" class="icon" size="24" weight="regular"></phcompass><span class="clamp text">Browse</span>
          </a></li>
        <li class="item"><a class="centerItems buttonLink link smallFont column centerAll link smallFont column centerAll" draggable="false" title="Albums">
            <phvinylrecord aria-hidden="true" class="icon" size="24" weight="regular"></phvinylrecord><span class="clamp text">Albums</span>
