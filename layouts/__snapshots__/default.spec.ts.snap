"<div class="mainLayout">
  <header class="centerItems header">
    <div class="spaceBetween inner centerItems"><a class="centerItems buttonLink mobileOnly mobileOnly" draggable="false" title="Home">
        <phwavesine aria-hidden="true" class="icon" size="32" weight="regular"></phwavesine><span class="clamp text visuallyHidden"> Home </span>
      </a><a class="centerItems buttonLink tvLogo tvLogo" draggable="false" title="Home">
        <phwavesine aria-hidden="true" class="icon" size="32" weight="regular"></phwavesine><span class="clamp text visuallyHidden"> Home </span>
      </a>
      <nav aria-label="Primary navigation" class="tvPrimaryNavigation tvPrimaryNavigation"><a exactactiveclass="tvPrimaryLinkActive" class="centerItems buttonLink tvPrimaryLink tvPrimaryLink" draggable="false">
          <phhouse aria-hidden="true" class="icon" size="24" weight="regular"></phhouse><span class="clamp text"> Home </span>
        </a><a exactactiveclass="tvPrimaryLinkActive" class="centerItems buttonLink tvPrimaryLink tvPrimaryLink" draggable="false">
          <phmagnifyingglass aria-hidden="true" class="icon" size="24" weight="regular"></phmagnifyingglass><span class="clamp text"> Search </span>
        </a><a exactactiveclass="tvPrimaryLinkActive" class="centerItems buttonLink tvPrimaryLink tvPrimaryLink" draggable="false">
          <phbooks aria-hidden="true" class="icon" size="24" weight="regular"></phbooks><span class="clamp text"> Your library </span>
        </a></nav>
      <div class="search" data-header-search="">
        <form novalidate="">
          <div class="centerItems">
            <div class="column inputField inputField"><label class="mBXS sentenceCase smallFont label visuallyHidden" for="search-input">query <span class="required">*</span></label><input id="search-input" autocomplete="off" class="input" placeholder="Search music" required="" type="text">
              <!--v-if-->
            </div><button class="centerItems buttonLink buttonLink buttonLink" draggable="false" type="submit">
              <phmagnifyingglass aria-hidden="true" class="icon" size="24" weight="regular"></phmagnifyingglass><span class="clamp text visuallyHidden"> Search </span>
            </button>
          </div>
        </form>
      </div>
      <!--v-if-->
    </div>
  </header>
  <aside>
    <div class="centerItems column sidebarNavigation desktopOnly">
      <div class="mBM centerAll spaceBetween header"><a class="centerItems buttonLink musicLogo musicLogo" draggable="false" title="Home">
          <phwavesine aria-hidden="true" class="icon" size="32" weight="regular"></phwavesine><span class="clamp text visuallyHidden"> Home </span>
        </a><button class="centerItems buttonLink" draggable="false" type="button" title="Close Navigation">
          <phtextoutdent aria-hidden="true" class="icon" size="24" weight="regular"></phtextoutdent><span class="clamp text visuallyHidden">Close Navigation</span>
        </button></div>
      <nav class="fullWidth">
        <ul class="mBM">
          <li class="mBM">
            <h4 class="strong mBM sectionHeading"><button aria-expanded="true" class="centerItems spaceBetween sectionToggle" type="button"><span>Browse</span>
                <phcaretdown aria-hidden="true" class="chevron" size="18" style="transform: rotate(0deg);"></phcaretdown>
              </button></h4>
            <ul>
              <li class=""><a exactactiveclass="sidebarCurrentLink" class="centerItems buttonLink sidebarLink sidebarLink" draggable="false" title="Discover">
                  <phcompass aria-hidden="true" class="icon" size="24" weight="regular"></phcompass><span class="clamp text">Discover</span>
                </a></li>
              <li class=""><a exactactiveclass="sidebarCurrentLink" class="centerItems buttonLink sidebarLink sidebarLink" draggable="false" title="Podcasts">
                  <phapplepodcastslogo aria-hidden="true" class="icon" size="24" weight="regular"></phapplepodcastslogo><span class="clamp text">Podcasts</span>
                </a></li>
              <li class=""><a exactactiveclass="sidebarCurrentLink" class="centerItems buttonLink sidebarLink sidebarLink" draggable="false" title="Radio Stations">
                  <phradio aria-hidden="true" class="icon" size="24" weight="regular"></phradio><span class="clamp text">Radio Stations</span>
                </a></li>
              <li class="isDroppable"><a exactactiveclass="sidebarCurrentLink" class="centerItems buttonLink sidebarLink sidebarLink" draggable="false" title="Queue">
                  <phqueue aria-hidden="true" class="icon" size="24" weight="regular"></phqueue><span class="clamp text">Queue</span>
                </a></li>
              <li class=""><a exactactiveclass="sidebarCurrentLink" class="centerItems buttonLink sidebarLink sidebarLink" draggable="false" title="Bookmarks">
                  <phbookmarks aria-hidden="true" class="icon" size="24" weight="regular"></phbookmarks><span class="clamp text">Bookmarks</span>
                </a></li>
              <li class=""><a exactactiveclass="sidebarCurrentLink" class="centerItems buttonLink sidebarLink sidebarLink" draggable="false" title="Library">
                  <phfolder aria-hidden="true" class="icon" size="24" weight="regular"></phfolder><span class="clamp text">Library</span>
                </a></li>
            </ul>
          </li>
          <li class="mBM">
            <h4 class="strong mBM sectionHeading"><button aria-expanded="true" class="centerItems spaceBetween sectionToggle" type="button"><span>Your library</span>
                <phcaretdown aria-hidden="true" class="chevron" size="18" style="transform: rotate(0deg);"></phcaretdown>
              </button></h4>
            <ul>
              <li class=""><a exactactiveclass="sidebarCurrentLink" class="centerItems buttonLink sidebarLink sidebarLink" draggable="false" title="Albums">
                  <phvinylrecord aria-hidden="true" class="icon" size="24" weight="regular"></phvinylrecord><span class="clamp text">Albums</span>
