exports[`genres > matches the snapshot 1`] = `
"<nav aria-label="Your library" class="webosLibraryNavigation">
  <ul class="webosLibraryTabs">
    <li><a class="centerItems buttonLink webosLibraryTab webosLibraryTabActive webosLibraryTab webosLibraryTabActive" draggable="false" aria-current="page">
        <phmusicnotes aria-hidden="true" class="icon" size="18" weight="regular"></phmusicnotes><span class="clamp text">All</span>
      </a></li>
    <li><a class="centerItems buttonLink webosLibraryTab webosLibraryTab" draggable="false">
        <phvinylrecord aria-hidden="true" class="icon" size="18" weight="regular"></phvinylrecord><span class="clamp text">Albums</span>
      </a></li>
    <li><a class="centerItems buttonLink webosLibraryTab webosLibraryTab" draggable="false">
        <phusersthree aria-hidden="true" class="icon" size="18" weight="regular"></phusersthree><span class="clamp text">Artist</span>
      </a></li>
    <li><a class="centerItems buttonLink webosLibraryTab webosLibraryTab" draggable="false">
        <phplaylist aria-hidden="true" class="icon" size="18" weight="regular"></phplaylist><span class="clamp text">Playlists</span>
      </a></li>
    <li><a class="centerItems buttonLink webosLibraryTab webosLibraryTab" draggable="false">
        <phwaveform aria-hidden="true" class="icon" size="18" weight="regular"></phwaveform><span class="clamp text">Genres</span>
      </a></li>
    <li><a class="centerItems buttonLink webosLibraryTab webosLibraryTab" draggable="false">
        <phapplepodcastslogo aria-hidden="true" class="icon" size="18" weight="regular"></phapplepodcastslogo><span class="clamp text">Podcast</span>
      </a></li>
  </ul>
</nav>
<h1>Genres</h1>
<div class="column centerAll loadingData" style="display: none;"><span class="mainLoader"><span class="headphones"><svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.25" viewBox="0 0 24 24" width="75" xmlns="http://www.w3.org/2000/svg"><path d="M4 13.5V13c0-4.97 3.582-9 8-9s8 4.03 8 9v.5"></path><path d="M2 17.439v-1.877a2 2 0 0 1 1.515-1.94L4 13.5l1.254-.314a.6.6 0 0 1 .746.582v5.464a.6.6 0 0 1-.746.582l-1.74-.435A2 2 0 0 1 2 17.439ZM22 17.439v-1.877a2 2 0 0 0-1.515-1.94L20 13.5l-1.255-.314a.6.6 0 0 0-.745.582v5.464a.6.6 0 0 0 .745.582l1.74-.435A2 2 0 0 0 22 17.439Z"></path></svg></span><span class="centerItems loader"><span class="bar"></span><span class="bar"></span><span class="bar"></span><span class="bar"></span></span><span class="visuallyHidden">Loading data</span></span></div>
<div class="mainContent">
  <div class="column centerAll noMediaMessage">
    <phwaveform size="50"></phwaveform>
    <p>No genres found.</p>
  </div>
</div>"
`;

